# SOP model-routing configuration example.
#
# Copy this file to `.env` (which is gitignored) and edit it. `.env` is
# OPTIONAL: existing SOP_* environment variables work without it, and it is never
# required in CI. A value already present in the process environment always wins
# over the file.
#
# Precedence (highest first):
#   --model-class flag > environment / .env > .agent-sdlc/config.yaml (models:) > built-in defaults
#
# The model-routing layer is off unless a SOP_MODEL_* variable (or the models:
# block in config.yaml, or --model-class) is set, so an existing project is
# unchanged.
#
# Secrets (API keys, tokens, authorization headers) may also live here, exactly
# as they may live in the environment. They are never written to SOP state or to
# model-selection evidence. Never commit a real .env.

# Which class the default agent uses: small | medium | large.
SOP_MODEL_DEFAULT_CLASS=large

# Model used when the selected class has no model (optional).
SOP_MODEL_FALLBACK_CLASS=medium

# Whether a local class may fall back to a cloud model. Default false, so SOP
# never silently switches local execution to a cloud model. This guard controls
# only the CONFIG-COMPLETENESS fallback (a local class with no model using a
# cloud fallback_class); the per-class SMALL availability fallback below is
# authorized by its own explicit `fallback:` configuration.
SOP_MODEL_ALLOW_CLOUD_FALLBACK_FOR_LOCAL=false

# Per-class routing.
# provider: ollama | llamacpp | command   locality: local | cloud
#
# SMALL is local-first with a cloud AVAILABILITY fallback: the local primary runs
# unless its local runtime (Ollama) is healthy but cannot serve the configured
# local model. In that one case the class's cloud fallback runs instead. The
# selected class stays SMALL; this is NOT quality escalation (SMALL -> MEDIUM ->
# LARGE), which is failure-driven and separate.
#
# Ollama
SOP_MODEL_SMALL_PROVIDER=ollama
SOP_MODEL_SMALL_NAME=qwen3:4b
SOP_MODEL_SMALL_LOCALITY=local

# SMALL availability fallback (used only when the local Ollama runtime is healthy
# but the configured local SMALL model cannot be served).
SOP_MODEL_SMALL_FALLBACK_PROVIDER=ollama
SOP_MODEL_SMALL_FALLBACK_NAME=nemotron-3-nano:30b-cloud
SOP_MODEL_SMALL_FALLBACK_LOCALITY=cloud

SOP_MODEL_MEDIUM_PROVIDER=ollama
SOP_MODEL_MEDIUM_NAME=nemotron-3-super:cloud
SOP_MODEL_MEDIUM_LOCALITY=cloud

SOP_MODEL_LARGE_PROVIDER=ollama
SOP_MODEL_LARGE_NAME=deepseek-v4.1-flash:cloud
SOP_MODEL_LARGE_LOCALITY=cloud

# Provider credentials (optional; kept separate from any persisted
# model-selection evidence).
# SOP_LLAMACPP_API_KEY=
