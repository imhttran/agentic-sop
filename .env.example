# SOP model-routing configuration example.
#
# Copy this file to `.env` in the project you run `sop` from (SOP reads `.env`
# from the current folder only), add `.env` to that project's .gitignore, and
# edit it. `.env` is
# OPTIONAL: existing SOP_* environment variables work without it, and it is never
# required in CI. A value already present in the process environment always wins
# over the file.
#
# Precedence (highest first):
#   --model-class flag > environment / .env > .agent-sdlc/config.yaml (models:) > built-in defaults
#
# The model-routing layer is off unless a SOP_MODEL_* variable (or the models:
# block in config.yaml, or --model-class) is set, so an existing project is
# unchanged.
#
# Secrets (API keys, tokens, authorization headers) may also live here, exactly
# as they may live in the environment. They are never written to SOP state or to
# model-selection evidence. Never commit a real .env.

# Which class the default agent uses: small | medium | large.
SOP_MODEL_DEFAULT_CLASS=large

# Model used when the selected class has no model (optional).
SOP_MODEL_FALLBACK_CLASS=medium

# Whether a local class may fall back to a cloud model. Default false, so SOP
# never silently switches local execution to a cloud model. This guard controls
# only the CONFIG-COMPLETENESS fallback (a local class with no model using a
# cloud fallback_class); the per-class SMALL availability fallback below is
# authorized by its own explicit `fallback:` configuration.
SOP_MODEL_ALLOW_CLOUD_FALLBACK_FOR_LOCAL=false

# Per-class routing.
# provider: ollama | llamacpp | mlx | openai_compatible | command
# locality: local | cloud
#
# SMALL is local-first with a cloud AVAILABILITY fallback: the local primary runs
# unless its local runtime (Ollama) is healthy but cannot serve the configured
# local model. In that one case the class's cloud fallback runs instead. The
# selected class stays SMALL; this is NOT quality escalation (SMALL -> MEDIUM ->
# LARGE), which is failure-driven and separate.
#
# Ollama
SOP_MODEL_SMALL_PROVIDER=ollama
SOP_MODEL_SMALL_NAME=qwen3:4b
SOP_MODEL_SMALL_LOCALITY=local

# SMALL availability fallback (used only when the local Ollama runtime is healthy
# but the configured local SMALL model cannot be served).
SOP_MODEL_SMALL_FALLBACK_PROVIDER=ollama
SOP_MODEL_SMALL_FALLBACK_NAME=nemotron-3-nano:30b-cloud
SOP_MODEL_SMALL_FALLBACK_LOCALITY=cloud

SOP_MODEL_MEDIUM_PROVIDER=ollama
SOP_MODEL_MEDIUM_NAME=nemotron-3-super:cloud
SOP_MODEL_MEDIUM_LOCALITY=cloud

# Claude for SMALL and MEDIUM (optional; replace the matching lines above).
#
# SMALL: Haiku through the Anthropic API. SOP sends the class's *_NAME as the
# model, so each API class can use a different Claude model. A cloud primary
# never uses the SMALL availability fallback above. The API is read-only: one
# chat call, no tools, no file edits. It serves REVIEW, PLAN, DESIGN_TESTS, and
# DIAGNOSE_FAILURE; SOP rejects IMPLEMENT and FIX on it. Use it only for a class
# that never implements (not the default class, and not with
# SOP_MODEL_ROUTING_ENABLED=true, which can route an implementation to SMALL).
# SOP_MODEL_SMALL_PROVIDER=openai_compatible
# SOP_MODEL_SMALL_NAME=claude-haiku-5-5
# SOP_MODEL_SMALL_LOCALITY=cloud
# SOP_OPENAI_COMPATIBLE_BASE_URL=https://api.anthropic.com
#
# MEDIUM: Opus at low effort through the Claude Code CLI wrapper (see the claude
# profile below). SOP has no effort setting of its own; the wrapper passes
# SOP_CLAUDE_EFFORT to the CLI. SOP_AGENT_COMMAND and the SOP_CLAUDE_* settings
# are shared by every class using provider=command, so with the claude LARGE
# profile below LARGE also runs at low effort: only one CLI effort level is
# possible today. Do not move LARGE to claude-api to avoid that; LARGE is the
# default class and runs IMPLEMENT and FIX, which the API cannot do. Edit .env
# by hand for this setup: switch-large-model.py deletes SOP_AGENT_COMMAND lines
# outside its blocks.
# SOP_MODEL_MEDIUM_PROVIDER=command
# SOP_MODEL_MEDIUM_NAME=claude-opus-5-5
# SOP_MODEL_MEDIUM_LOCALITY=cloud
# SOP_AGENT_COMMAND="sh /path/to/agentic-sop/scripts/agents/sop-agent.sh"
# ANTHROPIC_MODEL=claude-opus-5-5
# SOP_CLAUDE_EFFORT=low

# Claude CLI wrapper permissions (optional). The wrapper already lets Claude run
# the project's validation.build/test/lint commands; add other tool rules here,
# comma-separated. Anything listed is allowed without asking, so never add
# commit, push, or other commands SOP must own.
# SOP_CLAUDE_ALLOWED_TOOLS=Bash(make:*),Bash(pytest:*)

# LARGE profiles. Switch with `scripts/switch-large-model.py {claude|claude-api|deepseek}`;
# it rewrites the BEGIN/END blocks below, so keep edits and secrets outside them.
#
# claude:     Claude Code CLI through scripts/agents/sop-agent.sh. The wrapper
#             turns SOP's JSON request into a prompt, lets Claude edit files,
#             and returns the JSON outcome SOP expects; a bare `claude -p`
#             cannot edit files or answer in that format. Use the absolute
#             path to your agentic-sop checkout (the switch script fills it
#             in). Needs `claude` and `jq` on PATH; auth comes from
#             `claude login` (or ANTHROPIC_API_KEY). ANTHROPIC_MODEL picks the
#             model; *_NAME is only the label SOP records. SOP_AGENT_COMMAND
#             is global: any class or plan step using provider=command runs it.
# claude-api: Anthropic API directly through its OpenAI-compatible endpoint
#             (SOP appends /v1/chat/completions). Needs
#             SOP_OPENAI_COMPATIBLE_API_KEY (see credentials below). No local
#             CLI required. Read-only: one chat call per request, no file
#             edits. SOP rejects IMPLEMENT and FIX on this provider, so a LARGE
#             that is also the default class cannot implement tasks with it.
#             Use it only when LARGE serves review, plan, test design, or
#             diagnosis, and another class (on claude or ollama) implements.
#
# BEGIN SOP LARGE MODEL: claude
SOP_MODEL_LARGE_PROVIDER=command
SOP_MODEL_LARGE_NAME=claude-opus-5-5
SOP_MODEL_LARGE_LOCALITY=cloud
SOP_AGENT_COMMAND="sh /path/to/agentic-sop/scripts/agents/sop-agent.sh"
ANTHROPIC_MODEL=claude-opus-5-5
# END SOP LARGE MODEL: claude

# BEGIN SOP LARGE MODEL: claude-api
# SOP_MODEL_LARGE_PROVIDER=openai_compatible
# SOP_MODEL_LARGE_NAME=claude-opus-5-5
# SOP_MODEL_LARGE_LOCALITY=cloud
# SOP_OPENAI_COMPATIBLE_BASE_URL=https://api.anthropic.com
# END SOP LARGE MODEL: claude-api

# BEGIN SOP LARGE MODEL: deepseek
# SOP_MODEL_LARGE_PROVIDER=ollama
# SOP_MODEL_LARGE_NAME=deepseek-v4.1-flash:cloud
# SOP_MODEL_LARGE_LOCALITY=cloud
# END SOP LARGE MODEL: deepseek

# Provider credentials (optional; kept separate from any persisted
# model-selection evidence).
# SOP_LLAMACPP_API_KEY=
# Anthropic API key for the claude-api profile (sent as a Bearer token).
# SOP_OPENAI_COMPATIBLE_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# OPTIONAL: global decision adapter (SEAM-004 advisory decision layer)
#
# One local environment can configure the advisory decision adapter for every
# project - including runs launched by sop-controller, which inherit SOP's
# environment. The adapter is ADVISORY: it can only add attention (raise a
# result to a human boundary). SOP keeps deterministic validation, governance,
# and approval authority, and an explicit project .agent-sdlc/config.yaml
# decision block WINS over these variables.
#
# Precedence: explicit project configuration > environment > deterministic
# default. A project that sets decision.enabled: false stays disabled even when
# SOP_DECISION_ENABLED=true. SOP works unchanged with none of these set.
#
# SOP_DECISION_ENABLED=true
# SOP_DECISION_PROVIDER=adapter
# SOP_DECISION_ADAPTER_PROVIDER=nimble
# Unified argv (SOP appends "decide -file ... -json"): the adapter is served by the
# same sop executable. The legacy sop-decision-adapter binary keeps working.
# SOP_DECISION_ADAPTER_COMMAND=/usr/local/bin/sop decision
# SOP_DECISION_ADAPTER_MODEL=nimble
#
# Optional provider/helper assets: the Julia provider runs the repository-owned
# helper tools/julia/infer.py via JULIA_PYTHON (override with JULIA_INFERENCE_CMD);
# model weights remain external. Clef is opt-in via CLEF_ENABLED.

# RAG retrieval (disabled by default)
SOP_RAG_ENABLED=false
SOP_RAG_EXECUTABLE=
SOP_RAG_CORPUS=
SOP_RAG_ALLOWED_CORPORA=
SOP_RAG_TIMEOUT=3000
SOP_RAG_TOP_K=5
SOP_RAG_CONTEXT_BUDGET=4096
