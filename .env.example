# SOP Controller configuration. Copy to .env to override; every value is
# optional and the defaults are shown. No secrets belong in this file.

# HTTP listen address. Loopback by default — the dashboard is local-first.
SOP_CONTROLLER_ADDR=127.0.0.1:8080

# One or more directories that each contain an initialized SOP state
# (.agent-sdlc/state.db). Comma-separated; default is the current directory.
SOP_CONTROLLER_PROJECTS=.

# Alternatively (or in addition), one or more workspace roots. The controller
# discovers SOP projects beneath these roots by finding .agent-sdlc/config.yaml.
# Workspace roots are an explicit security boundary: the controller never scans
# outside them. Comma-separated.
# SOP_CONTROLLER_WORKSPACES=/Users/you/agentic-workspace

# Maximum directory depth below a workspace root when discovering projects.
# SOP_CONTROLLER_DISCOVERY_DEPTH=4

# SOP CLI used for commands (run/resume/validate/review/report).
SOP_BIN=sop

# HTMX polling cadence for active views.
SOP_CONTROLLER_POLL=3s

# Longest a single SOP command may run before it is abandoned.
SOP_CONTROLLER_COMMAND_TIMEOUT=15m

# Network mode is OFF by default (loopback only). Exposing the dashboard on
# the LAN is an explicit opt-in that also requires an access token.
SOP_CONTROLLER_ALLOW_NETWORK=false
# SOP_CONTROLLER_TOKEN=

# The actor recorded for approve/decline decisions. When set, it is authoritative and the
# form's actor field is ignored (an editable field is a label, not a verified identity).
# SOP_CONTROLLER_OPERATOR=

# Remembered-device sessions: how long a signed-in browser stays signed in, and where the
# (owner-only, hashed) session records are kept so a device stays signed in across
# controller restarts. The lifetime is capped at 30 days.
# SOP_CONTROLLER_SESSION_TTL=720h
# SOP_CONTROLLER_SESSION_FILE=.run/sessions.json


# Local bare metal
# SOP_SMALL_PROVIDER=ollama
# SOP_SMALL_MODEL=qwen3.5:4b
# SOP_SMALL_LOCALITY=local
#
# SOP_MEDIUM_PROVIDER=ollama
# SOP_MEDIUM_MODEL=qwen3-coder:30b
# SOP_MEDIUM_LOCALITY=local
#
# SOP_LARGE_PROVIDER=ollama
# SOP_LARGE_MODEL=qwen3-coder-next
# SOP_LARGE_LOCALITY=local
