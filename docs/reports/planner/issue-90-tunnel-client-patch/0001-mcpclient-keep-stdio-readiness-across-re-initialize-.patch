 		c.release()
 	}
@@ -666,6 +684,51 @@ func (t *serializedForwardingTransport) resetInitialization() {
 	t.initializedMu.Lock()
 	t.initializeSucceeded = false
 	t.initializationReady = false
+	t.childEpoch++
+	t.initializedMu.Unlock()
+}
+
+// currentChildEpoch returns the epoch a new connection starts in.
+func (t *serializedForwardingTransport) currentChildEpoch() uint64 {
+	if t == nil {
+		return 0
+	}
+	t.initializedMu.Lock()
+	defer t.initializedMu.Unlock()
+	return t.childEpoch
+}
+
+// resetInitializationFromEpoch resets readiness only if no reset has happened since
+// the connection that is closing started. Otherwise the child it used is already gone
+// and the readiness flags describe a replacement that must not be revoked.
+func (t *serializedForwardingTransport) resetInitializationFromEpoch(epoch uint64) {
+	if t == nil || !t.requireInitialization {
+		return
+	}
+	t.initializedMu.Lock()
+	defer t.initializedMu.Unlock()
+	if t.childEpoch != epoch {
+		return
+	}
+	t.initializeSucceeded = false
+	t.initializationReady = false
+	t.initializedNotification = false
+	t.childEpoch++
+}
+
+// beginInitialize records an accepted initialize. A child that is already ready
+// stays ready: its handshake completed and it was not closed, so another session's
+// re-initialize must not revoke readiness for requests already using it (a
+// duplicate initialize the server rejects would otherwise leave it unready until
+// a restart). A child that is not ready starts a fresh handshake.
+func (t *serializedForwardingTransport) beginInitialize() {
+	if t == nil || !t.requireInitialization {
+		return
+	}
+	t.initializedMu.Lock()
+	if !t.initializationReady {
+		t.initializeSucceeded = false
+	}
 	t.initializedMu.Unlock()
 }
 
@@ -704,9 +767,24 @@ func (c *serializedForwardingConnection) Close() error {
 	if c.isRetired() {
 		return nil
 	}
+	if c.transport != nil && c.transport.requireInitialization && c.lifecycleFinished() {
+		// A late Close of an older, finished connection (for example after its
+		// response POST failed) has nothing in flight. The shared child may be
+		// serving another session, so neither its readiness nor its pipes are this
+		// connection's to reset. Abandoned requests, fatal I/O and a Close while the
+		// slot is held still take the destructive path below.
+		return nil
+	}
 	if c.transport != nil {
-		c.transport.resetInitializedNotification()
-		c.transport.resetInitialization()
+		c.stateMu.Lock()
+		epoch := c.childEpoch
+		c.stateMu.Unlock()
+		if c.transport.requireInitialization {
+			c.transport.resetInitializationFromEpoch(epoch)
+		} else {
+			c.transport.resetInitializedNotification()
+			c.transport.resetInitialization()
+		}
 		c.transport.observation.childClosed(c.observationGeneration, "stdio_connection_closed")
 	}
 	defer c.release()
@@ -756,6 +834,10 @@ func (c *serializedForwardingConnection) acquire(ctx context.Context, expectResp
 		if err := c.acquireLifecycle(ctx); err != nil {
 			return jsonrpc.ID{}, err
 		}
+		epoch := c.transport.currentChildEpoch()
+		c.stateMu.Lock()
+		c.childEpoch = epoch
+		c.stateMu.Unlock()
 	}
 
 	expectedID := callerID
@@ -782,6 +864,7 @@ func (c *serializedForwardingConnection) acquire(ctx context.Context, expectResp
 	c.requestMethod = method
 	c.deadlineRetirable = false
 	c.retired = false
+	c.lifecycleDone = false
 	if c.transport != nil && (c.transport.observation != nil || c.transport.requireInitialization) {
 		c.observationWriteDone = make(chan struct{})
 		c.observationWriteReady = false
@@ -830,6 +913,7 @@ func (c *serializedForwardingConnection) shouldReleaseAfterRead(msg jsonrpc.Mess
 		return false
 	}
 	if !c.awaitingResponse {
+		c.lifecycleDone = true
 		return true
 	}
 
@@ -844,6 +928,7 @@ func (c *serializedForwardingConnection) shouldReleaseAfterRead(msg jsonrpc.Mess
 	}
 
 	c.awaitingResponse = false
+	c.lifecycleDone = true
 	return true
 }
 
@@ -856,6 +941,24 @@ func (c *serializedForwardingConnection) release() {
 	}
 }
 
+// releaseDone releases the slot for a request that finished normally.
+func (c *serializedForwardingConnection) releaseDone() {
+	c.stateMu.Lock()
+	if c.lockHeld {
+		c.lifecycleDone = true
+	}
+	c.stateMu.Unlock()
+	c.release()
+}
+
+// lifecycleFinished reports whether this connection no longer holds the lifecycle
+// slot because its request finished normally.
+func (c *serializedForwardingConnection) lifecycleFinished() bool {
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	return !c.lockHeld && c.lifecycleDone
+}
+
 func (c *serializedForwardingConnection) releaseRetired() {
 	c.stateMu.Lock()
 	lockHeld := c.lockHeld
