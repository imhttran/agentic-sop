-func TestStdioInitializationReinitializeRequiresNewNotification(t *testing.T) {
+// A re-initialize on a child that already completed its handshake and was not closed
+// must not revoke readiness: other sessions share the child and may be mid-use.
+func TestStdioInitializationReinitializeKeepsReadyChildReady(t *testing.T) {
+	t.Parallel()
+	for _, shim := range []bool{false, true} {
+		name := "caller_notification"
+		if shim {
+			name = "shim_notification"
+		}
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			transport, base := initializationTransport(shim)
+			initializationReady(t, transport, base, shim)
+			id := initializationID(t, "second-initialize")
+			initializationRoundTrip(t, transport, base, &jsonrpc.Request{ID: id, Method: "initialize"}, &jsonrpc.Response{ID: id})
+			// Between the second initialize response and any second notification.
+			request := &jsonrpc.Request{ID: initializationID(t, "tool"), Method: "tools/call"}
+			initializationRoundTrip(t, transport, base, request, &jsonrpc.Response{ID: request.ID})
+			require.Zero(t, base.closeCalls.Load())
+		})
+	}
+}
+
+// Cross-session: session B re-initializes the shared child while session A's call is
+// in flight. A's call must not be rejected in the window before B's notification.
+func TestStdioInitializationOtherSessionCallSurvivesReinitializeWindow(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false) // session A is ready
+	idB := initializationID(t, "initialize-B")
+	initializationRoundTrip(t, transport, base, &jsonrpc.Request{ID: idB, Method: "initialize"}, &jsonrpc.Response{ID: idB})
+
+	callA := &jsonrpc.Request{ID: initializationID(t, float64(0)), Method: "tools/call"}
+	initializationRoundTrip(t, transport, base, callA, &jsonrpc.Response{ID: callA.ID})
+
+	initializationNotify(t, transport, initializedNotificationMethod) // B's notification
+	callB := &jsonrpc.Request{ID: initializationID(t, float64(1)), Method: "tools/call"}
+	initializationRoundTrip(t, transport, base, callB, &jsonrpc.Response{ID: callB.ID})
+	require.Equal(t, []string{"initialize", initializedNotificationMethod, "initialize", "tools/call", initializedNotificationMethod, "tools/call"}, base.writtenMethods())
+}
+
+// A server may reject a duplicate initialize (go-sdk does) while staying initialized.
+// That error must not strand the ready child as unready until a restart.
+func TestStdioInitializationRejectedReinitializeKeepsReadyChildReady(t *testing.T) {
 	t.Parallel()
 	transport, base := initializationTransport(false)
 	initializationReady(t, transport, base, false)
-	id := initializationID(t, "second-initialize")
-	initializationRoundTrip(t, transport, base, &jsonrpc.Request{ID: id, Method: "initialize"}, &jsonrpc.Response{ID: id})
+	id := initializationID(t, "duplicate-initialize")
+	initializationRoundTrip(t, transport, base, &jsonrpc.Request{ID: id, Method: "initialize"},
+		&jsonrpc.Response{ID: id, Error: &jsonrpc.Error{Code: -32603, Message: "duplicate initialize received"}})
+	initializationNotify(t, transport, initializedNotificationMethod)
+	request := &jsonrpc.Request{ID: initializationID(t, "tool"), Method: "tools/call"}
+	initializationRoundTrip(t, transport, base, request, &jsonrpc.Response{ID: request.ID})
+}
+
+// Enforcement is preserved for a child that really was closed (and so respawned): a
+// later initialize alone does not make it ready; the notification does.
+func TestStdioInitializationClosedChildStillRequiresFullHandshake(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false)
+	conn, err := transport.Connect(context.Background())
+	require.NoError(t, err)
+	require.NoError(t, conn.Close()) // holds the slot: a real close
+	require.EqualValues(t, 1, base.closeCalls.Load())
+
 	request := &jsonrpc.Request{ID: initializationID(t, "tool"), Method: "tools/call"}
 	initializationRequireRejected(t, transport, base, request)
+	id := initializationID(t, "initialize-after-close")
+	initializationRoundTrip(t, transport, base, &jsonrpc.Request{ID: id, Method: "initialize"}, &jsonrpc.Response{ID: id})
+	initializationRequireRejected(t, transport, base, request)
 	initializationNotify(t, transport, initializedNotificationMethod)
 	initializationRoundTrip(t, transport, base, request, &jsonrpc.Response{ID: request.ID})
 }
 
+// A late Close of an older connection whose request already finished (the dispatcher
+// does this after a non-deadline response-POST failure) must not reset readiness or
+// close the shared pipes under a sibling request that holds the lifecycle slot.
+func TestStdioInitializationLateCloseOfFinishedConnectionKeepsSiblingReady(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false)
+
+	id1 := initializationID(t, "call-1")
+	conn1, err := transport.Connect(context.Background())
+	require.NoError(t, err)
+	_, err = conn1.Write(context.Background(), nil, &jsonrpc.Request{ID: id1, Method: "tools/call"})
+	require.NoError(t, err)
+	base.enqueueRead(&jsonrpc.Response{ID: id1}, nil)
+	_, err = conn1.Read(context.Background())
+	require.NoError(t, err)
+
+	id2 := initializationID(t, "call-2")
+	conn2, err := transport.Connect(context.Background())
+	require.NoError(t, err)
+	_, err = conn2.Write(context.Background(), nil, &jsonrpc.Request{ID: id2, Method: "tools/call"})
+	require.NoError(t, err)
+
+	require.NoError(t, conn1.Close()) // late close of the finished connection
+	require.Zero(t, base.closeCalls.Load(), "shared pipes must stay open under the in-flight sibling")
+
+	base.enqueueRead(&jsonrpc.Response{ID: id2}, nil)
+	_, err = conn2.Read(context.Background())
+	require.NoError(t, err)
+	next := &jsonrpc.Request{ID: initializationID(t, "call-3"), Method: "tools/call"}
+	initializationRoundTrip(t, transport, base, next, &jsonrpc.Response{ID: next.ID})
+	require.NoError(t, conn1.Close(), "Close stays idempotent")
+	require.Zero(t, base.closeCalls.Load())
+}
+
+// Closing a connection that still has a request in flight remains destructive: the
+// response may arrive late on the shared pipes, so the child is closed and unready.
+func TestStdioInitializationCloseOfInFlightRequestStillResets(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false)
+	conn, err := transport.Connect(context.Background())
+	require.NoError(t, err)
+	_, err = conn.Write(context.Background(), nil, &jsonrpc.Request{ID: initializationID(t, "in-flight"), Method: "tools/call"})
+	require.NoError(t, err)
+	require.NoError(t, conn.Close())
+	require.EqualValues(t, 1, base.closeCalls.Load())
+	initializationRequireRejected(t, transport, base, &jsonrpc.Request{ID: initializationID(t, "next"), Method: "tools/call"})
+}
+
+// A request abandoned by a read failure resets readiness itself; the late Close that
+// follows must neither undo that nor be needed to enforce the guard.
+func TestStdioInitializationAbandonedReadThenLateCloseStaysUnready(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false)
+	conn, err := transport.Connect(context.Background())
+	require.NoError(t, err)
+	_, err = conn.Write(context.Background(), nil, &jsonrpc.Request{ID: initializationID(t, "abandoned"), Method: "tools/call"})
+	require.NoError(t, err)
+	base.enqueueRead(nil, io.EOF)
+	_, err = conn.Read(context.Background())
+	require.ErrorIs(t, err, io.EOF)
+	require.NoError(t, conn.Close())
+	initializationRequireRejected(t, transport, base, &jsonrpc.Request{ID: initializationID(t, "next"), Method: "tools/call"})
+}
+
 func TestStdioInitializationCanceledUnwrittenInitializePreservesReadyChild(t *testing.T) {
 	t.Parallel()
 	transport, base := initializationTransport(false)
@@ -477,3 +608,57 @@ func initializationReady(t *testing.T, transport ForwardingTransport, base *stub
 		initializationNotify(t, transport, initializedNotificationMethod)
 	}
 }
+
+// A request abandoned by a read failure leaves the slot with a connection whose Close
+// is still destructive (it purges the shared pipes). If a sibling has meanwhile
+// re-handshaken the replaced child, that late Close must not revoke the sibling's
+// readiness: the readiness it would reset describes a different child.
+func TestStdioInitializationLateCloseOfAbandonedConnectionKeepsReplacementReady(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false)
+
+	abandoned, err := transport.Connect(context.Background())
+	require.NoError(t, err)
+	_, err = abandoned.Write(context.Background(), nil, &jsonrpc.Request{ID: initializationID(t, "abandoned"), Method: "tools/call"})
+	require.NoError(t, err)
+	base.enqueueRead(nil, io.EOF)
+	_, err = abandoned.Read(context.Background())
+	require.ErrorIs(t, err, io.EOF) // child lost: readiness reset, slot released
+
+	// A sibling completes the full handshake on the replacement child.
+	initializationReady(t, transport, base, false)
+
+	require.NoError(t, abandoned.Close()) // the dispatcher's late Close of the old connection
+
+	request := &jsonrpc.Request{ID: initializationID(t, "tool"), Method: "tools/call"}
+	initializationRoundTrip(t, transport, base, request, &jsonrpc.Response{ID: request.ID})
+}
+
+// Late Closes of finished connections racing with the next requests must neither
+// race (-race) nor revoke readiness.
+func TestStdioInitializationConcurrentLateClosesKeepReadiness(t *testing.T) {
+	t.Parallel()
+	transport, base := initializationTransport(false)
+	initializationReady(t, transport, base, false)
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		id := initializationID(t, fmt.Sprintf("call-%d", i))
+		conn, err := transport.Connect(context.Background())
+		require.NoError(t, err)
+		_, err = conn.Write(context.Background(), nil, &jsonrpc.Request{ID: id, Method: "tools/call"})
+		require.NoError(t, err)
+		base.enqueueRead(&jsonrpc.Response{ID: id}, nil)
+		_, err = conn.Read(context.Background())
+		require.NoError(t, err)
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_ = conn.Close()
+		}()
+	}
+	wg.Wait()
+	require.Zero(t, base.closeCalls.Load())
+	request := &jsonrpc.Request{ID: initializationID(t, "final"), Method: "tools/call"}
+	initializationRoundTrip(t, transport, base, request, &jsonrpc.Response{ID: request.ID})
+}
