@@ -0,0 +1,23 @@
+package synthetic
+
+import "testing"
+
+func TestAdd(t *testing.T) {
+	cases := []struct {
+		name string
+		a, b int
+		want int
+	}{
+		{"positive", 1, 2, 3},
+		{"zero", 0, 0, 0},
+		{"negative", -1, -2, -3},
+		{"mixed sign", -1, 1, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := Add(tc.a, tc.b); got != tc.want {
+				t.Errorf("Add(%d, %d) = %d, want %d", tc.a, tc.b, got, tc.want)
+			}
+		})
+	}
+}
