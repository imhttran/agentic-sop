.DS_Store
/sop
# Build outputs the agents leave at the repository root (see scripts/agents/sop-agent.sh);
# they are large binaries and must never enter a diff or a commit.
/sop-*

# Local configuration and credentials (commit .env.example instead).
.env

# Project-local agent skills, created by `scripts/install/install-skills.sh <agent> --project`.
# They are symlinks into ./skills/ and are never committed.
.agents/
.claude/

# Editor/browser tooling scratch (e.g. Playwright MCP accessibility snapshots);
# not project content.
.playwright-mcp/
.env.bak

# Machine-local overrides and notes (e.g. CLAUDE.local.md, settings.local.json);
# never checked in.
*.local
*.local.*

# Rust build output generated when an editor analyzes the security fixtures;
# never project content. Fixture Cargo.lock files stay tracked deliberately.
target/

# HIP comparison harness shared budget ledger (opt-in runtime state).
.hipcompare-budget.json

# Local offline security inputs, all fetched and never committed. The Semgrep
# rules are license-restricted (docs/guides/SECURITY-SCANNER-ADDON.md), and the
# advisory/OSV databases are large and machine-local. Scans read these paths but
# never fetch or refresh them.
.agent-sdlc/security-rules/
.agent-sdlc/advisory-db/
.agent-sdlc/osv-db/

# Scan run evidence is machine-local and regenerated by every scan. The reviewed
# config and baseline under .agent-sdlc stay tracked.
.agent-sdlc/runs/
