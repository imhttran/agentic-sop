# Local environment
.env
.env.*
!.env.example

# SOP authoritative state: owned by SOP, mutable, never tracked here.
.agent-sdlc/state.db
.agent-sdlc/state.db-wal
.agent-sdlc/state.db-shm
.agent-sdlc/runs/
.agent-sdlc/plan.json

# Editor state
.zed/

# macOS
.DS_Store

# Build + run artifacts
.run/
/sop-controller

# Caddy local HTTPS data: CA and certificate private keys must never be committed.
.caddy/

# Playwright end-to-end test tooling (development only; never needed to build or run)
node_modules/
/test-results/
/playwright-report/
/.e2e/
/.playwright-mcp/
