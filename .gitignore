.DS_Store
/sop
# Build outputs the agents leave at the repository root (see scripts/agents/sop-agent.sh);
# they are large binaries and must never enter a diff or a commit.
/sop-*

# Local configuration and credentials (commit .env.example instead).
.env

# Project-local agent skills, created by `scripts/install/install-skills.sh <agent> --project`.
# They are symlinks into ./skills/ and are never committed.
.agents/
.claude/

# Editor/browser tooling scratch (e.g. Playwright MCP accessibility snapshots);
# not project content.
.playwright-mcp/
.env.bak

# Machine-local overrides and notes (e.g. CLAUDE.local.md, settings.local.json);
# never checked in.
*.local
*.local.*

# Rust build output generated when an editor analyzes the security fixtures;
# never project content. Fixture Cargo.lock files stay tracked deliberately.
target/
